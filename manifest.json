{
  "id": "cdb",
  "name": "CDB Cadastro",
  "version": "1.3.1",
  "description": "Assistente de cadastro de CDBs brasileiros (% CDI e prefixados) com cálculo de PU pela série do BCB",
  "author": "Danilo",
  "main": "dist/addon.js",
  "sdkVersion": "3.8.0",
  "minWealthfolioVersion": "3.8.0",
  "enabled": true,
  "contributes": {
    "routes": [{ "id": "cdb" }],
    "links": {
      "sidebar": [
        {
          "id": "cdb",
          "route": "cdb",
          "label": "CDB Cadastro",
          "icon": "squares-four",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.8.0",
    "@wealthfolio/ui": "^3.8.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [{ "name": "getAll", "isDeclared": true }],
      "purpose": "Listar contas para associar a compra do CDB"
    },
    {
      "category": "activities",
      "functions": [{ "name": "create", "isDeclared": true }],
      "purpose": "Registrar a atividade de compra e criar a security"
    },
    {
      "category": "assets",
      "functions": [{ "name": "updateProfile", "isDeclared": true }],
      "purpose": "Configurar o custom provider de market data do ativo (symbol override)"
    },
    {
      "category": "market-data",
      "functions": [{ "name": "sync", "isDeclared": true }, { "name": "getProviders", "isDeclared": true }],
      "purpose": "Sincronizar o preço do novo CDB logo após o cadastro"
    },
    {
      "category": "quotes",
      "functions": [{ "name": "getHistory", "isDeclared": true }],
      "purpose": "Conferir se o preço chegou após o cadastro (validação do provider)"
    },
    {
      "category": "network",
      "functions": [{ "name": "request", "isDeclared": true }],
      "purpose": "Obter a série diária do CDI diretamente do Banco Central (api.bcb.gov.br)"
    }
  ],
  "network": {
    "allowedHosts": ["api.bcb.gov.br"]
  },
  "keywords": ["wealthfolio", "addon", "cdb", "cdi", "brazil"],
  "license": "MIT"
}
