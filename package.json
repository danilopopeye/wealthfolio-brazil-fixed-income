{
  "name": "wealthfolio-brazil-fixed-income",
  "version": "1.7.6",
  "description": "Wealthfolio addon for Brazilian fixed income: registers CDB, LCI, LCA and LCDA titles (%CDI and pre-fixed) with PU computed from the BCB CDI series",
  "type": "module",
  "main": "dist/addon.js",
  "keywords": [
    "wealthfolio",
    "addon",
    "brazil",
    "fixed-income",
    "cdi",
    "cdb",
    "lci"
  ],
  "license": "MIT",
  "author": "Danilo",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/danilopopeye/wealthfolio-brazil-fixed-income.git"
  },
  "homepage": "https://github.com/danilopopeye/wealthfolio-brazil-fixed-income#readme",
  "bugs": {
    "url": "https://github.com/danilopopeye/wealthfolio-brazil-fixed-income/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio-addon dev",
    "clean": "rm -rf dist",
    "test": "tsx scripts/check-engine.ts",
    "check": "pnpm type-check && pnpm test",
    "sync:version": "node scripts/sync-version.mjs",
    "package": "pnpm sync:version && mkdir -p dist assets && find dist -name '*.map' -delete && zip -r dist/$npm_package_name-$npm_package_version.zip manifest.json dist/ assets/ README.md -x '*.map'",
    "bundle": "pnpm sync:version && pnpm clean && pnpm build && pnpm package",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.8.0",
    "@wealthfolio/ui": "^3.8.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.90.20",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@wealthfolio/addon-dev-tools": "^3.9.0",
    "@wealthfolio/addon-sdk": "^3.8.0",
    "@wealthfolio/ui": "^3.8.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
